#!/bin/bash

ENC_FILE="secrets.enc"
TMP_FILE=".secrets.tmp"

case "$1" in
  view)
    openssl enc -d -aes-256-cbc -pbkdf2 -in "$ENC_FILE"
    ;;

  edit)
    if openssl enc -d -aes-256-cbc -pbkdf2 -in "$ENC_FILE" -out "$TMP_FILE"; then
      chmod 600 "$TMP_FILE"
      nano "$TMP_FILE"

      echo
      echo "Зберігаю зашифрований файл..."

      if openssl enc -aes-256-cbc -salt -pbkdf2 -in "$TMP_FILE" -out "${ENC_FILE}.new"; then
        mv "${ENC_FILE}.new" "$ENC_FILE"
        rm -f "$TMP_FILE"
        echo "Готово. Незашифрований файл видалено."
      else
        rm -f "${ENC_FILE}.new"
        echo "Помилка шифрування. Тимчасовий файл залишено."
        exit 1
      fi
    else
      echo "Неправильний пароль або помилка розшифрування."
      rm -f "$TMP_FILE"
      exit 1
    fi
    ;;

  *)
    echo "Використання:"
    echo "  ./secrets view   — переглянути"
    echo "  ./secrets edit   — редагувати"
    ;;
esac
